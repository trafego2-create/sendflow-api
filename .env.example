# SendFlow SendAPI (ver "API Keys" no painel SendFlow -> aba SendAPI)
SENDFLOW_BASE_URL=https://sendapi.sendflow.pro
SENDFLOW_API_TOKEN=cole-o-bearer-token-aqui
# ID da campanha (release) a monitorar. Se não souber, rode
# `python -m app.list_releases` depois de preencher SENDFLOW_API_TOKEN acima
# para listar todas as campanhas do usuário com seus IDs.
SENDFLOW_RELEASE_ID=

# Google Sheets (Service Account) - mesma planilha que o serviço principal já
# usa (sendflow-leads-service), reaproveitando a mesma service account e a
# mesma aba LEAD TOTAL. Cole o JSON inteiro em uma linha só.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}
GOOGLE_SHEET_ID=1QPpVLzJtREtyOTNYBvq8RNNtGq8DV62i744FVQ2NQj4
GOOGLE_SHEET_NAME=LEAD TOTAL

# Opcional: admins EXTRAS além da lista base já fixa em app/config.py
# (ADMIN_NUMBERS_BASE, todos os ~30 admins da empresa toda). Só preencher se
# esse lançamento específico tiver algum staff que não está na lista base.
ADMIN_NUMBERS=

# Linha onde ficam TOTAL GRUPOS CHEIOS/TOTAL LEADS (padrão 2) e linha onde fica
# TOTAL LIMPO (padrão 3) - nem toda aba segue esse layout (ex: abas VIP mais
# antigas às vezes têm TOTAL LIMPO na linha 4). Confira a aba real antes de
# ativar num lançamento novo.
SUMMARY_ROW=2
TOTAL_LIMPO_ROW=3

# A cada quantos minutos consultar /analytics e corrigir ENTRADAS/SAÍDAS na
# planilha
POLL_INTERVAL_MINUTES=15
# A cada quantos minutos consultar /actions/export-leads e recalcular o Total
# Limpo (API) - mais espaçado porque essa chamada é mais pesada (lista todo
# mundo, não só um contador)
TOTAL_LIMPO_POLL_INTERVAL_MINUTES=30

# Supabase - MESMO projeto do sendflow-leads-service (mesma URL/chave), mas
# tabela PRÓPRIA e nova (não usa a tabela do serviço principal). Copie
# SUPABASE_URL/SUPABASE_SERVICE_KEY do .env do sendflow-leads-service.
SUPABASE_URL=https://bjfapsvlhojiouarbzap.supabase.co
SUPABASE_SERVICE_KEY=coloque-a-service-role-key-aqui
SUPABASE_TABLE=PI_AGO_26_API
# A cada quantos minutos sincronizar a lista completa de leads com o Supabase
LEADS_SYNC_INTERVAL_MINUTES=30

TIMEZONE=America/Sao_Paulo
PORT=8000
